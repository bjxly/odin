# ============================================================
# ODIN Docker 环境变量
# MySQL 使用 DB_* 前缀，PostgreSQL 使用 PG_* 前缀
# ============================================================

# SmartJ 部署环境变量
# 除 FRONTEND_PORT 外，其余 *_PORT 均为宿主机映射端口：在容器内端口前加 2。
# 容器之间通过服务名和容器内端口通信，不使用宿主机映射端口。
SMARTJ_DEPLOY_MODE=boot
SMARTJ_DATASOURCE_DIALECT=mysql

# 浏览器可访问的服务器地址，用于生成本地文件访问 URL
SERVER_IP=localhost

# ===== 数据库 =====
# DB_NAME/DB_USERNAME/DB_PASSWORD 同时用于 MySQL 与 PostgreSQL 初始化，
# 也是 db-presets.yml 的连接占位符（${DB_URL}/${DB_USERNAME}/${DB_PASSWORD}）
DB_HOST=mysql
DB_PORT=13306
DB_NAME=smartj
DB_USERNAME=root
DB_PASSWORD=odin123456
DB_URL=jdbc:mysql://${DB_HOST}:3306/${DB_NAME}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# 数据源方言：对应后端 smartj.datasource.dialect
SMARTJ_DATASOURCE_DIALECT=mysql

# Redis
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=odin123456

# 应用
BACKEND_PORT=28090
FRONTEND_PORT=23200
JAVA_OPTS=-Xms512m -Xmx4g -XX:+UseG1GC
JWT_KEY_PATH=/app/config/smartj-jwt.key
SMARTJ_AGENT_TOKEN_SECRET=JI8Mc5WP+r0G8E0qucXmQ8KuOekB4fuwKR9tM249+to=

# 短信服务提供方（console = 控制台打印验证码，不依赖外部短信通道；免 SSO 单体沿用主应用自带短信能力）
SMARTJ_SMS_PROVIDER=console

# 本地文件存储：宿主机 ./data/uploads 挂载到以下容器内目录
OSS_TYPE=local
OSS_LOCAL_BASE_PATH=/app/uploads
OSS_LOCAL_BASE_URL=http://${SERVER_IP}:${FRONTEND_PORT}/api/oss/files

# OSS
#minio外网地址
OSS_ACCESS_KEY=admin
OSS_SECRET_KEY=odin123456
OSS_API_PORT=19000
OSS_CONSOLE_PORT=19010

# Jasypt 加密配置
JASYPT_ENCRYPTOR_PASSWORD=smartj-odin-key

# 通用环境变量（所有环境共享）
VITE_API_BASE_URL=/api

# iconfont font-class 模式 CSS 地址（可选，默认使用 public/iconfont/iconfont.css）
VITE_ICONFONT_CSS_URL=

# 登录页主题（可选，默认 dark；可选值：dark / light / split）
VITE_LOGIN_THEME=light

# 是否启用登录与权限控制（默认 true；设置为 false 进入免登录模式，仅用于内部系统构建，需搭配 .env.internal 使用）
VITE_AUTH_ENABLED=true
# 免登录模式下由运维预签发的长期 JWT
VITE_INTERNAL_TOKEN=

# ===== 多应用 SSO 单点登录（默认关闭，保持免 SSO 单体应用行为不变）=====
# VITE_SSO_ENABLED=false 时登录/Token/公开配置全部走主应用本地 /auth/*，不依赖 SSO 认证中心。
# 设为 true 才启用 SSO 模式（须同时设置 VITE_AUTH_ENABLED=true）。
VITE_SSO_ENABLED=false
# SSO 认证中心地址（浏览器直达，须含 context-path /sso）；仅 SSO_ENABLED=true 时生效。
VITE_SSO_SERVER_URL=http://localhost:8000/sso
# 本应用在 SSO 管理端注册的 client_id；仅 SSO_ENABLED=true 时生效。
VITE_SSO_CLIENT_ID=

# 内部系统专用构建 mode（npm run build:internal）
# 使用方式：复制本文件为 .env.internal，填入运维预先签发的长期 JWT
#
# 该文件包含密钥，已在 .gitignore 中忽略，禁止提交到仓库。
VITE_APP_TITLE=SmartJOne 内部版
VITE_ENV=production
VITE_API_BASE_URL=/api

# 关闭登录与权限控制（免登录模式）
VITE_AUTH_ENABLED=false

# 运维预先通过现有 /sso/auth/login 或独立脚本签发的长期 JWT（建议有效期 >= 1 年）
# 内部版产物启动时会自动注入到 authStore，业务接口沿用现有请求拦截器发送 Bearer Token
VITE_INTERNAL_TOKEN=
